<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- KSP 1.12 tourne sur Mono (profil .NET 4.x) : pas de netstandard.dll dans Managed/ -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OrbitDeck.Ksp1</AssemblyName>
    <RootNamespace>OrbitDeck.Ksp1</RootNamespace>
    <Version>0.4.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Les DLL du jeu ne sont jamais copiées (Private=false) ; seule Newtonsoft.Json l'est -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Target Name="CheckKsp1Dir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Ksp1ManagedDir)\Assembly-CSharp.dll')"
           Text="Dossier du jeu introuvable : définir Ksp1Dir dans mod/Directory.Build.props.user ou la variable d'environnement KSP1_DIR (valeur actuelle : '$(Ksp1Dir)')." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Ksp1ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Ksp1ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Code commun avec le mod KSP 2 : tout ce qui ne dépend pas du jeu (serveur, protocole, commandes, télémétrie) -->
  <ItemGroup>
    <Compile Include="..\OrbitDeck.Mod\Server\*.cs" Link="Shared\Server\%(Filename)%(Extension)" />
    <Compile Include="..\OrbitDeck.Mod\Protocol\*.cs" Link="Shared\Protocol\%(Filename)%(Extension)" />
    <Compile Include="..\OrbitDeck.Mod\Commands\GameCommand.cs;..\OrbitDeck.Mod\Commands\IGameControls.cs;..\OrbitDeck.Mod\Commands\CommandValidator.cs;..\OrbitDeck.Mod\Commands\CommandQueue.cs" Link="Shared\Commands\%(Filename)%(Extension)" />
    <Compile Include="..\OrbitDeck.Mod\Config\OrbitDeckConfig.cs" Link="Shared\Config\%(Filename)%(Extension)" />
    <Compile Include="..\OrbitDeck.Mod\Telemetry\TelemetrySnapshot.cs;..\OrbitDeck.Mod\Telemetry\IGameState.cs;..\OrbitDeck.Mod\Telemetry\ITelemetrySource.cs;..\OrbitDeck.Mod\Telemetry\SnapshotComparer.cs" Link="Shared\Telemetry\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    KSP 1 ne fournit pas Newtonsoft.Json : la DLL est livrée avec le mod. On prend la version « net20 » du paquet : les autres
    (net35, net45…) exigent System.Runtime.Serialization, absent du dossier Managed de KSP 1, et plantent au premier appel.
  -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PkgNewtonsoft_Json)\lib\net20\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Déploiement : copie les DLL dans <jeu>\GameData\OrbitDeck\Plugins\ -->
  <Target Name="DeployToKsp1" AfterTargets="Build" Condition="Exists('$(Ksp1Dir)')">
    <PropertyGroup>
      <ModDeployDir>$(Ksp1Dir)\GameData\OrbitDeck\Plugins</ModDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(OutputPath)OrbitDeck.Ksp1.dll;$(OutputPath)Newtonsoft.Json.dll" DestinationFolder="$(ModDeployDir)" />
    <!-- La configuration n'est copiée que si elle n'existe pas encore (ne jamais écraser les réglages de l'utilisateur) -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\package\orbitdeck-config.json" DestinationFolder="$(ModDeployDir)"
          Condition="!Exists('$(ModDeployDir)\orbitdeck-config.json')" />
    <Message Importance="high" Text="OrbitDeck (KSP 1) déployé dans $(ModDeployDir)" />
  </Target>

</Project>
